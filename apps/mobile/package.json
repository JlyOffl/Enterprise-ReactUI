{
  "name": "@erui/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "align-deps": "npx expo install --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
