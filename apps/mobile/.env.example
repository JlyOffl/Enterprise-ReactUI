# Copy to .env and adjust (Expo inlines EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/v1
EXPO_PUBLIC_USE_MOCK_API=true
EXPO_PUBLIC_EXTERNAL_SYSTEM_ID=ERUI-MOBILE
EXPO_PUBLIC_LOG_LEVEL=debug
# Requires a development build with the Dynatrace plugin configured (see dynatrace.config.example.js)
EXPO_PUBLIC_DYNATRACE_ENABLED=false
