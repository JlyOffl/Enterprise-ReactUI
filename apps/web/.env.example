# Copy to .env.local and adjust
VITE_APP_ENV=development
VITE_API_BASE_URL=https://api.example.com/v1
# true = in-process mock backend (no server needed)
VITE_USE_MOCK_API=true
VITE_EXTERNAL_SYSTEM_ID=ERUI-WEB
VITE_LOG_LEVEL=debug
# Dynatrace RUM: enable and point to your RUM JavaScript tag (Settings > Web and mobile monitoring)
VITE_DYNATRACE_ENABLED=false
VITE_DYNATRACE_SCRIPT_URL=
